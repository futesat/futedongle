ctrl_interface=/var/run/hostapd
interface=wlan0

hw_mode=a
ieee80211n=1
ieee80211ac=1
channel=36
vht_oper_chwidth=1
vht_oper_centr_freq_seg0_idx=42
vht_capab=[SHORT-GI-80]

auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP

ssid=futedongle

#wpa_passphrase=ConnectAAWirelessDongle
#country_code=IN
