#!/bin/sh
#
# Two-stage garage door opener over hidden/visible 2.4 GHz Wi-Fi + UDP:
#   1. "start" (at S38 boot, before S39hostapd_conf and S40network):
#      Probes whether the garage Wi-Fi AP is in range, caches its operating
#      frequency, DHCP lease (IP, subnet, gateway), and target ARP MAC in
#      /var/run/garage_env + /var/run/garage_in_range WITHOUT opening the door,
#      then cleans up wlan0 completely so the 5 GHz Android Auto AP starts cleanly.
#   2. "fire" (invoked once by aawgd when Android Auto foreground video starts):
#      Temporarily switches wlan0 from hostapd to the cached garage channel/IP,
#      transmits the UDP trigger burst via /usr/bin/garage_udp_send, and
#      deterministically restores the 5 GHz hostapd AP (10.0.0.1/24) + dnsmasq.
#

export PATH="/sbin:/usr/sbin:/bin:/usr/bin"

if [ -r /etc/aawgd.conf ]; then
	set -a
	. /etc/aawgd.conf
	set +a
fi

WPA_PIDFILE="/var/run/garage_wpa.pid"
WPA_CONF="/var/run/garage_wpa.conf"
WPA_LOG="/var/run/garage_wpa.log"
UDHCPC_PIDFILE="/var/run/garage_udhcpc.pid"
UDHCPC_SCRIPT="/var/run/garage_udhcpc.script"
GARAGE_DHCP_ENV="/var/run/garage_dhcp.env"
GARAGE_ENV_FILE="/var/run/garage_env"
GARAGE_IN_RANGE_FLAG="/var/run/garage_in_range"
GARAGE_OPENED_ONCE_FLAG="/var/run/garage_opened_once"

GARAGE_TOUCHED_WLAN0=0
NEED_RESTORE_AP=0
WATCHDOG_PID=""

log_info() {
	echo "garage_opener: $1"
	logger -p daemon.info -t garage_opener "$1" 2>/dev/null || true
}

kill_wpa_and_wait() {
	if [ -f "$WPA_PIDFILE" ]; then
		WPA_PID="$(cat "$WPA_PIDFILE" 2>/dev/null)"
		if [ -n "$WPA_PID" ]; then
			kill "$WPA_PID" 2>/dev/null || true
		fi
		rm -f "$WPA_PIDFILE"
	fi

	killall -q wpa_supplicant 2>/dev/null || true

	W_CNT=0
	while pidof wpa_supplicant >/dev/null 2>&1 && [ "$W_CNT" -lt 15 ]; do
		sleep 0.1
		W_CNT=$((W_CNT + 1))
	done
	if pidof wpa_supplicant >/dev/null 2>&1; then
		killall -9 -q wpa_supplicant 2>/dev/null || true
		sleep 0.2
	fi
	rm -f "$WPA_LOG"
}

stop_watchdog() {
	if [ -n "$WATCHDOG_PID" ]; then
		kill "$WATCHDOG_PID" 2>/dev/null || true
		wait "$WATCHDOG_PID" 2>/dev/null || true
		WATCHDOG_PID=""
	fi
}

cleanup() {
	stop_watchdog

	if [ "$GARAGE_TOUCHED_WLAN0" != "1" ]; then
		return 0
	fi
	GARAGE_TOUCHED_WLAN0=0

	if [ -f "$UDHCPC_PIDFILE" ]; then
		kill "$(cat "$UDHCPC_PIDFILE" 2>/dev/null)" 2>/dev/null || true
		rm -f "$UDHCPC_PIDFILE"
	fi

	kill_wpa_and_wait

	rm -f "$WPA_CONF" "$WPA_LOG" "$UDHCPC_SCRIPT" "$GARAGE_DHCP_ENV" /tmp/resolv.conf

	iw dev wlan0 disconnect 2>/dev/null || true
	ip route flush dev wlan0 2>/dev/null || true
	ip addr flush dev wlan0 2>/dev/null || true
	ip neigh flush dev wlan0 2>/dev/null || true
	ip link set wlan0 down 2>/dev/null || true
	iw dev wlan0 set type managed 2>/dev/null || true

	# Re-apply configured regulatory domain in case the 2.4 GHz AP advertised
	# a conflicting 802.11d Country IE that could block 5 GHz Channel 36.
	if [ -n "${AAWG_COUNTRY_CODE:-}" ]; then
		iw reg set "${AAWG_COUNTRY_CODE}" 2>/dev/null || true
	fi

	# Allow CYW43455 SDIO firmware state machine to settle before hostapd starts
	sleep 0.2
}

restore_ap() {
	if [ "$NEED_RESTORE_AP" != "1" ]; then
		return 0
	fi
	NEED_RESTORE_AP=0

	log_info "Restoring 5 GHz Android Auto AP on wlan0..."
	rfkill unblock wifi 2>/dev/null || true
	if [ -n "${AAWG_COUNTRY_CODE:-}" ]; then
		iw reg set "${AAWG_COUNTRY_CODE}" 2>/dev/null || true
	fi

	if [ ! -f /var/run/hostapd.conf ] && [ -x /etc/init.d/S39hostapd_conf ]; then
		/etc/init.d/S39hostapd_conf start >/dev/null 2>&1 || true
	fi

	# Ensure any lingering dnsmasq is stopped before bringing the AP up so we
	# never kill/restart dnsmasq after hostapd is already broadcasting beacons.
	if pidof dnsmasq >/dev/null 2>&1; then
		killall -q dnsmasq 2>/dev/null || true
		D_TICK=0
		while pidof dnsmasq >/dev/null 2>&1 && [ "$D_TICK" -lt 10 ]; do
			sleep 0.1
			D_TICK=$((D_TICK + 1))
		done
		if pidof dnsmasq >/dev/null 2>&1; then
			killall -9 -q dnsmasq 2>/dev/null || true
			sleep 0.1
		fi
		rm -f /var/run/dnsmasq.pid 2>/dev/null || true
	fi

	AP_UP=0
	ATTEMPT=1
	while [ "$ATTEMPT" -le 3 ]; do
		killall -q hostapd 2>/dev/null || true
		H_WAIT=0
		while pidof hostapd >/dev/null 2>&1 && [ "$H_WAIT" -lt 10 ]; do
			sleep 0.1
			H_WAIT=$((H_WAIT + 1))
		done
		rm -rf /var/run/hostapd 2>/dev/null || true
		ip link set wlan0 down 2>/dev/null || true
		hostapd -B /var/run/hostapd.conf -t -f /var/log/hostapd >/dev/null 2>&1 || true
		ifconfig wlan0 10.0.0.1 netmask 255.255.255.0 up 2>/dev/null || true
		iw dev wlan0 set power_save off 2>/dev/null || true

		# Start dnsmasq immediately once wlan0 is in AP mode with 10.0.0.1/24
		# so UDP port 67 is ready as soon as the phone associates.
		if ! pidof dnsmasq >/dev/null 2>&1; then
			rm -f /var/run/dnsmasq.pid 2>/dev/null || true
			if [ -x /etc/init.d/S80dnsmasq ]; then
				/etc/init.d/S80dnsmasq start >/dev/null 2>&1 || true
			fi
			if ! pidof dnsmasq >/dev/null 2>&1; then
				dnsmasq >/dev/null 2>&1 || true
			fi
		fi

		H_TICK=0
		while [ "$H_TICK" -lt 15 ]; do
			WLAN_INFO="$(iw dev wlan0 info 2>/dev/null)"
			if pidof hostapd >/dev/null 2>&1 && \
			   printf '%s\n' "$WLAN_INFO" | grep -q "type AP" && \
			   printf '%s\n' "$WLAN_INFO" | grep -q "channel "; then
				AP_UP=1
				break
			fi
			sleep 0.1
			H_TICK=$((H_TICK + 1))
		done

		if [ "$AP_UP" = "1" ]; then
			break
		fi
		log_info "hostapd start attempt ${ATTEMPT} did not reach AP mode; retrying..."
		sleep 0.3
		ATTEMPT=$((ATTEMPT + 1))
	done

	# Re-assert 10.0.0.1/24 after hostapd transitions wlan0 into AP mode
	ifconfig wlan0 10.0.0.1 netmask 255.255.255.0 up 2>/dev/null || true
	if ! pidof dnsmasq >/dev/null 2>&1; then
		dnsmasq >/dev/null 2>&1 || true
	fi

	if [ "$AP_UP" = "1" ]; then
		log_info "5 GHz Android Auto AP restored on wlan0 (10.0.0.1); ready for fast phone reconnect."
	else
		log_info "WARNING: hostapd did not confirm AP mode after 3 attempts."
	fi
}

write_wpa_conf() {
	TARGET_FREQ_LIST="$1"
	(
		umask 077
		{
			printf 'ap_scan=1\n'
			[ -n "$TARGET_FREQ_LIST" ] && printf '%s\n' "$TARGET_FREQ_LIST"
			printf 'network={\n'
			printf '\tssid="%s"\n' "$ESC_SSID"
			printf '\tscan_ssid=%s\n' "$SCAN_SSID"
			if [ -n "$PASSWORD" ]; then
				printf '\tpsk="%s"\n' "$ESC_PASS"
				printf '\tkey_mgmt=WPA-PSK\n'
			else
				printf '\tkey_mgmt=NONE\n'
			fi
			[ -n "$TARGET_FREQ_LIST" ] && printf '\t%s\n' "$TARGET_FREQ_LIST"
			printf '}\n'
		} > "$WPA_CONF"
	)
}

write_udhcpc_script() {
	cat << 'EOF' > "$UDHCPC_SCRIPT"
#!/bin/sh
case "$1" in
	bound|renew)
		ifconfig "$interface" "$ip" ${subnet:+netmask "$subnet"} up
		FIRST_GW=""
		for gw in $router; do
			if [ -z "$FIRST_GW" ]; then
				FIRST_GW="$gw"
			fi
			ip route add default via "$gw" dev "$interface" 2>/dev/null && break
		done
		if [ -n "$dns" ]; then
			: > /tmp/resolv.conf
			for ns in $dns; do
				echo "nameserver $ns" >> /tmp/resolv.conf
			done
		fi
		{
			printf 'GARAGE_IP="%s"\n' "$ip"
			printf 'GARAGE_SUBNET="%s"\n' "${subnet:-255.255.255.0}"
			printf 'GARAGE_GW="%s"\n' "$FIRST_GW"
		} > /var/run/garage_dhcp.env
		;;
esac
exit 0
EOF
	chmod 700 "$UDHCPC_SCRIPT"
}

wait_for_wpa_connection() {
	MAX_TICKS="$1"
	TICK=0
	while [ "$TICK" -lt "$MAX_TICKS" ]; do
		if [ "$(cat /sys/class/net/wlan0/carrier 2>/dev/null)" = "1" ] && \
		   iw dev wlan0 link 2>/dev/null | grep -q "^Connected to " && \
		   grep -q "CTRL-EVENT-CONNECTED" "$WPA_LOG" 2>/dev/null; then
			return 0
		fi
		sleep 0.1
		TICK=$((TICK + 1))
	done
	return 1
}

load_garage_config() {
	SSID="${AAWG_GARAGE_WIFI_SSID:-}"
	PASSWORD="${AAWG_GARAGE_WIFI_PASSWORD:-}"
	HIDDEN="${AAWG_GARAGE_WIFI_HIDDEN:-1}"
	BAND="${AAWG_GARAGE_WIFI_BAND:-2.4}"
	UDP_HOST="${AAWG_GARAGE_UDP_HOST:-}"
	UDP_PORT="${AAWG_GARAGE_UDP_PORT:-9876}"
	UDP_PAYLOAD="${AAWG_GARAGE_UDP_PAYLOAD:-OPEN_BOTH_GARAGE_FIRST}"
	TIMEOUT_SEC="${AAWG_GARAGE_TIMEOUT_SEC:-5}"

	case "$TIMEOUT_SEC" in
		''|*[!0-9]*) TIMEOUT_SEC=5 ;;
	esac
	[ "$TIMEOUT_SEC" -lt 2 ] && TIMEOUT_SEC=2
	[ "$TIMEOUT_SEC" -gt 15 ] && TIMEOUT_SEC=15

	ESC_SSID=$(printf '%s' "$SSID" | sed 's/\\/\\\\/g; s/"/\\"/g')
	ESC_PASS=$(printf '%s' "$PASSWORD" | sed 's/\\/\\\\/g; s/"/\\"/g')
	SCAN_SSID=0
	[ "$HIDDEN" = "1" ] && SCAN_SSID=1

	FULL_FREQ_LIST=""
	if [ "$BAND" = "2.4" ]; then
		FULL_FREQ_LIST="freq_list=2412 2417 2422 2427 2432 2437 2442 2447 2452 2457 2462 2467 2472"
	fi
}

probe_garage_at_boot() {
	rm -f "$GARAGE_IN_RANGE_FLAG" "$GARAGE_OPENED_ONCE_FLAG" "$GARAGE_ENV_FILE" "$GARAGE_DHCP_ENV"

	if [ "${AAWG_ENABLE_GARAGE_OPEN:-0}" != "1" ]; then
		log_info "Disabled (AAWG_ENABLE_GARAGE_OPEN != 1), skipping boot probe."
		return 0
	fi

	load_garage_config

	if [ -z "$SSID" ] || [ -z "$UDP_HOST" ] || [ -z "$UDP_PORT" ]; then
		log_info "Missing garage SSID or UDP target configuration, skipping."
		return 0
	fi

	if pidof hostapd >/dev/null 2>&1; then
		log_info "hostapd is already running on wlan0; skipping boot probe."
		return 0
	fi

	WAIT_COUNT=0
	while [ ! -d /sys/class/net/wlan0 ] && [ "$WAIT_COUNT" -lt 50 ]; do
		sleep 0.2
		WAIT_COUNT=$((WAIT_COUNT + 1))
	done

	if [ ! -d /sys/class/net/wlan0 ]; then
		log_info "wlan0 interface did not appear in time, skipping."
		return 0
	fi

	GARAGE_TOUCHED_WLAN0=1
	trap 'trap "" EXIT INT TERM; cleanup; exit 0' EXIT INT TERM

	MAIN_PID=$$
	HARD_LIMIT=$((TIMEOUT_SEC + 5))
	(
		trap 'kill "$SPID" 2>/dev/null || true; exit 0' TERM INT
		sleep "$HARD_LIMIT" &
		SPID=$!
		if wait "$SPID" 2>/dev/null; then
			logger -p daemon.warning -t garage_opener "Boot probe hard watchdog (${HARD_LIMIT}s) reached; aborting to start Android Auto AP." 2>/dev/null || true
			kill -TERM "$MAIN_PID" 2>/dev/null || true
		fi
	) </dev/null >/dev/null 2>&1 &
	WATCHDOG_PID=$!

	ip link set lo up 2>/dev/null || true
	rfkill unblock wifi 2>/dev/null || true
	if [ -n "${AAWG_COUNTRY_CODE:-}" ]; then
		iw reg set "${AAWG_COUNTRY_CODE}" 2>/dev/null || true
	fi
	ip link set wlan0 up 2>/dev/null || true
	iw dev wlan0 set power_save off 2>/dev/null || true

	write_wpa_conf "$FULL_FREQ_LIST"

	rm -f "$WPA_LOG"
	log_info "Probing garage Wi-Fi '${SSID}' at boot (hidden=${SCAN_SSID}, band=${BAND}, timeout=${TIMEOUT_SEC}s)..."
	if ! wpa_supplicant -D nl80211 -i wlan0 -c "$WPA_CONF" -P "$WPA_PIDFILE" -f "$WPA_LOG" -B >/dev/null 2>&1; then
		log_info "Failed to launch wpa_supplicant during boot probe."
		return 0
	fi

	if ! wait_for_wpa_connection $((TIMEOUT_SEC * 10)); then
		log_info "Garage Wi-Fi '${SSID}' not in range at boot (${TIMEOUT_SEC}s timeout); garage trigger disarmed for this drive."
		return 0
	fi

	GARAGE_FREQ=$(iw dev wlan0 link 2>/dev/null | awk '/freq:/ {print $2; exit}')
	case "$GARAGE_FREQ" in
		''|*[!0-9]*) GARAGE_FREQ="" ;;
	esac

	write_udhcpc_script
	rm -f "$GARAGE_DHCP_ENV"
	if ! udhcpc -i wlan0 -n -q -t 2 -T 1 -A 0 -p "$UDHCPC_PIDFILE" -s "$UDHCPC_SCRIPT" >/dev/null 2>&1; then
		log_info "DHCP lease failed on '${SSID}' during boot probe; garage trigger disarmed for this drive."
		return 0
	fi

	# Pre-resolve Layer-2 ARP MAC of UDP_HOST via ICMP without sending UDP to port 9876
	ping -c 1 -W 1 "$UDP_HOST" >/dev/null 2>&1 || true
	GARAGE_TARGET_MAC=$(awk -v ip="$UDP_HOST" '$1 == ip && $3 != "0x0" && $4 != "00:00:00:00:00:00" && $6 == "wlan0" {print $4; exit}' /proc/net/arp 2>/dev/null)
	if [ -z "$GARAGE_TARGET_MAC" ]; then
		ping -c 1 -W 1 "$UDP_HOST" >/dev/null 2>&1 || true
		GARAGE_TARGET_MAC=$(awk -v ip="$UDP_HOST" '$1 == ip && $3 != "0x0" && $4 != "00:00:00:00:00:00" && $6 == "wlan0" {print $4; exit}' /proc/net/arp 2>/dev/null)
	fi

	if [ -f "$GARAGE_DHCP_ENV" ]; then
		. "$GARAGE_DHCP_ENV"
		cp "$GARAGE_DHCP_ENV" "$GARAGE_ENV_FILE"
	else
		: > "$GARAGE_ENV_FILE"
	fi

	GARAGE_GW_MAC=""
	if [ -n "${GARAGE_GW:-}" ]; then
		GARAGE_GW_MAC=$(awk -v ip="$GARAGE_GW" '$1 == ip && $3 != "0x0" && $4 != "00:00:00:00:00:00" && $6 == "wlan0" {print $4; exit}' /proc/net/arp 2>/dev/null)
	fi

	{
		printf 'GARAGE_FREQ="%s"\n' "$GARAGE_FREQ"
		printf 'GARAGE_TARGET_IP="%s"\n' "$UDP_HOST"
		printf 'GARAGE_TARGET_MAC="%s"\n' "$GARAGE_TARGET_MAC"
		printf 'GARAGE_GW_MAC="%s"\n' "$GARAGE_GW_MAC"
	} >> "$GARAGE_ENV_FILE"

	touch "$GARAGE_IN_RANGE_FLAG"
	log_info "Garage Wi-Fi '${SSID}' detected at boot (freq=${GARAGE_FREQ:-auto} MHz, ip=${GARAGE_IP:-dhcp}, mac=${GARAGE_TARGET_MAC:-arp}); armed for Android Auto foreground video trigger."
	return 0
}

fire_garage_at_runtime() {
	if [ -f "$GARAGE_OPENED_ONCE_FLAG" ]; then
		log_info "Garage opener already fired once this boot; skipping."
		return 0
	fi
	touch "$GARAGE_OPENED_ONCE_FLAG"
	rm -f "$GARAGE_IN_RANGE_FLAG"

	if [ "${AAWG_ENABLE_GARAGE_OPEN:-0}" != "1" ]; then
		log_info "Disabled (AAWG_ENABLE_GARAGE_OPEN != 1), skipping runtime fire."
		return 0
	fi

	load_garage_config

	if [ -z "$SSID" ] || [ -z "$UDP_HOST" ] || [ -z "$UDP_PORT" ]; then
		log_info "Missing garage SSID or UDP target configuration, skipping."
		return 0
	fi

	GARAGE_IP=""
	GARAGE_SUBNET=""
	GARAGE_GW=""
	GARAGE_GW_MAC=""
	GARAGE_FREQ=""
	GARAGE_TARGET_IP=""
	GARAGE_TARGET_MAC=""
	if [ -f "$GARAGE_ENV_FILE" ]; then
		. "$GARAGE_ENV_FILE"
	fi

	# Arm cleanup + unconditional 5 GHz AP restoration before touching hostapd
	GARAGE_TOUCHED_WLAN0=1
	NEED_RESTORE_AP=1
	trap 'trap "" EXIT INT TERM; cleanup; restore_ap; exit 0' EXIT INT TERM

	MAIN_PID=$$
	HARD_LIMIT=$((TIMEOUT_SEC + 9))
	(
		trap 'kill "$SPID" 2>/dev/null || true; exit 0' TERM INT
		sleep "$HARD_LIMIT" &
		SPID=$!
		if wait "$SPID" 2>/dev/null; then
			logger -p daemon.warning -t garage_opener "Runtime fire watchdog (${HARD_LIMIT}s) reached; restoring Android Auto AP." 2>/dev/null || true
			kill -TERM "$MAIN_PID" 2>/dev/null || true
		fi
	) </dev/null >/dev/null 2>&1 &
	WATCHDOG_PID=$!

	log_info "Stopping 5 GHz hostapd and dnsmasq to transmit garage UDP trigger over '${SSID}'..."
	killall -q hostapd dnsmasq 2>/dev/null || true
	H_CNT=0
	while { pidof hostapd >/dev/null 2>&1 || pidof dnsmasq >/dev/null 2>&1; } && [ "$H_CNT" -lt 10 ]; do
		sleep 0.1
		H_CNT=$((H_CNT + 1))
	done
	if pidof hostapd >/dev/null 2>&1 || pidof dnsmasq >/dev/null 2>&1; then
		killall -9 -q hostapd dnsmasq 2>/dev/null || true
		sleep 0.1
	fi
	rm -rf /var/run/hostapd /var/run/dnsmasq.pid 2>/dev/null || true

	ip route flush dev wlan0 2>/dev/null || true
	ip addr flush dev wlan0 2>/dev/null || true
	ip neigh flush dev wlan0 2>/dev/null || true
	ip link set wlan0 down 2>/dev/null || true
	iw dev wlan0 set type managed 2>/dev/null || true
	rfkill unblock wifi 2>/dev/null || true
	if [ -n "${AAWG_COUNTRY_CODE:-}" ]; then
		iw reg set "${AAWG_COUNTRY_CODE}" 2>/dev/null || true
	fi
	ip link set wlan0 up 2>/dev/null || true
	iw dev wlan0 set power_save off 2>/dev/null || true

	CONNECTED=0
	# Fast single-channel association if frequency was cached at boot
	if [ -n "$GARAGE_FREQ" ]; then
		rm -f "$WPA_LOG"
		write_wpa_conf "freq_list=${GARAGE_FREQ}"
		if wpa_supplicant -D nl80211 -i wlan0 -c "$WPA_CONF" -P "$WPA_PIDFILE" -f "$WPA_LOG" -B >/dev/null 2>&1; then
			if wait_for_wpa_connection 25; then
				CONNECTED=1
			else
				log_info "Single-channel lock (${GARAGE_FREQ} MHz) timed out; falling back to full band scan."
				kill_wpa_and_wait
			fi
		fi
	fi

	if [ "$CONNECTED" != "1" ]; then
		rm -f "$WPA_LOG"
		write_wpa_conf "$FULL_FREQ_LIST"
		if wpa_supplicant -D nl80211 -i wlan0 -c "$WPA_CONF" -P "$WPA_PIDFILE" -f "$WPA_LOG" -B >/dev/null 2>&1; then
			if wait_for_wpa_connection $((TIMEOUT_SEC * 10)); then
				CONNECTED=1
			fi
		fi
	fi

	if [ "$CONNECTED" != "1" ]; then
		log_info "Failed to associate with '${SSID}' during runtime trigger; restoring Android Auto AP."
		return 0
	fi

	# Fast-path IP & ARP configuration using the boot DHCP lease when available
	LEASE_READY=0
	if [ -n "$GARAGE_IP" ]; then
		if ifconfig wlan0 "$GARAGE_IP" ${GARAGE_SUBNET:+netmask "$GARAGE_SUBNET"} up 2>/dev/null; then
			if [ -n "$GARAGE_GW" ]; then
				ip route add default via "$GARAGE_GW" dev wlan0 2>/dev/null || true
				if [ -n "$GARAGE_GW_MAC" ]; then
					ip neigh replace "$GARAGE_GW" lladdr "$GARAGE_GW_MAC" nud reachable dev wlan0 2>/dev/null || true
				fi
			fi
			if [ -n "$GARAGE_TARGET_IP" ] && [ -n "$GARAGE_TARGET_MAC" ]; then
				ip neigh replace "$GARAGE_TARGET_IP" lladdr "$GARAGE_TARGET_MAC" nud reachable dev wlan0 2>/dev/null || true
			fi
			LEASE_READY=1
		fi
	fi

	if [ "$LEASE_READY" != "1" ]; then
		write_udhcpc_script
		if udhcpc -i wlan0 -n -q -t 2 -T 1 -A 0 -p "$UDHCPC_PIDFILE" -s "$UDHCPC_SCRIPT" >/dev/null 2>&1; then
			LEASE_READY=1
		fi
	fi

	if [ "$LEASE_READY" != "1" ]; then
		log_info "Failed to configure IP on '${SSID}'; restoring Android Auto AP."
		return 0
	fi

	if /usr/bin/garage_udp_send "$UDP_HOST" "$UDP_PORT" "$UDP_PAYLOAD"; then
		log_info "Garage UDP trigger sent to ${UDP_HOST}:${UDP_PORT}."
	else
		log_info "Garage UDP send failed to ${UDP_HOST}:${UDP_PORT}."
	fi

	return 0
}

case "$1" in
	start)
		probe_garage_at_boot
		stop_watchdog
		trap '' EXIT INT TERM
		cleanup
		;;
	fire)
		fire_garage_at_runtime
		stop_watchdog
		trap '' EXIT INT TERM
		cleanup
		restore_ap
		;;
	stop)
		if [ -f "$WPA_PIDFILE" ]; then
			GARAGE_TOUCHED_WLAN0=1
			trap '' EXIT INT TERM
			cleanup
		fi
		;;
	*)
		echo "Usage: $0 {start|fire|stop}"
		exit 1
		;;
esac

exit 0
