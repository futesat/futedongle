#!/bin/sh
#
# Smart garage door opener over 2.4 GHz Wi-Fi + UDP (Hold-until-START):
#   1. "start" (at S38 boot, before S39hostapd_conf and S40network):
#      Probes whether the garage Wi-Fi AP is in range.
#      - If in range: keeps wlan0 associated, caches frequency, DHCP lease and
#        target ARP MAC, and creates /var/run/garage_hold. S43garage_gate then
#        blocks the boot (no Android Auto AP, no phone Bluetooth, no aawgd).
#      - If not in range: cleans up wlan0 immediately so the normal boot continues.
#   2. "fire" (invoked by gte_telemetryd when Car START button is detected):
#      Transmits the UDP trigger burst over the held link, cleans up wlan0, and
#      removes /var/run/garage_hold so S43garage_gate brings up the 5 GHz AP.
#      If the hold is no longer active (timeout expired), "fire" does nothing.
#   3. "release" (invoked by S43garage_gate on hold timeout):
#      Releases the held link without opening, disarms the trigger for this drive,
#      and unblocks the boot.
#

export PATH="/sbin:/usr/sbin:/bin:/usr/bin"

# Later files override earlier ones (web portal settings live in /persist)
set -a
for CONF_FILE in /etc/aawgd.conf /boot/aawgd.conf /persist/aawgd.conf; do
	[ -r "$CONF_FILE" ] && . "$CONF_FILE"
done
set +a

WPA_PIDFILE="/var/run/garage_wpa.pid"
WPA_CONF="/var/run/garage_wpa.conf"
WPA_LOG="/var/run/garage_wpa.log"
UDHCPC_PIDFILE="/var/run/garage_udhcpc.pid"
UDHCPC_SCRIPT="/var/run/garage_udhcpc.script"
GARAGE_DHCP_ENV="/var/run/garage_dhcp.env"
GARAGE_ENV_FILE="/var/run/garage_env"
GARAGE_IN_RANGE_FLAG="/var/run/garage_in_range"
GARAGE_OPENED_ONCE_FLAG="/var/run/garage_opened_once"
GARAGE_HOLD_FLAG="/var/run/garage_hold"
GARAGE_LOCK_DIR="/var/run/garage_lock"

GARAGE_TOUCHED_WLAN0=0
WATCHDOG_PID=""

log_info() {
	echo "garage_opener: $1"
	logger -p daemon.info -t garage_opener "$1" 2>/dev/null || true
}

kill_wpa_and_wait() {
	if [ -f "$WPA_PIDFILE" ]; then
		WPA_PID="$(cat "$WPA_PIDFILE" 2>/dev/null)"
		if [ -n "$WPA_PID" ]; then
			kill "$WPA_PID" 2>/dev/null || true
		fi
		rm -f "$WPA_PIDFILE"
	fi

	killall -q wpa_supplicant 2>/dev/null || true

	W_CNT=0
	while pidof wpa_supplicant >/dev/null 2>&1 && [ "$W_CNT" -lt 15 ]; do
		sleep 0.1
		W_CNT=$((W_CNT + 1))
	done
	if pidof wpa_supplicant >/dev/null 2>&1; then
		killall -9 -q wpa_supplicant 2>/dev/null || true
		sleep 0.2
	fi
	rm -f "$WPA_LOG"
}

stop_watchdog() {
	if [ -n "$WATCHDOG_PID" ]; then
		kill "$WATCHDOG_PID" 2>/dev/null || true
		wait "$WATCHDOG_PID" 2>/dev/null || true
		WATCHDOG_PID=""
	fi
}

cleanup() {
	stop_watchdog

	if [ "$GARAGE_TOUCHED_WLAN0" != "1" ]; then
		return 0
	fi
	GARAGE_TOUCHED_WLAN0=0

	if [ -f "$UDHCPC_PIDFILE" ]; then
		kill "$(cat "$UDHCPC_PIDFILE" 2>/dev/null)" 2>/dev/null || true
		rm -f "$UDHCPC_PIDFILE"
	fi

	kill_wpa_and_wait

	rm -f "$WPA_CONF" "$WPA_LOG" "$UDHCPC_SCRIPT" "$GARAGE_DHCP_ENV" /tmp/resolv.conf

	iw dev wlan0 disconnect >/dev/null 2>&1 || true
	ip route flush dev wlan0 >/dev/null 2>&1 || true
	ip addr flush dev wlan0 >/dev/null 2>&1 || true
	ip neigh flush dev wlan0 >/dev/null 2>&1 || true
	ip link set wlan0 down >/dev/null 2>&1 || true
	iw dev wlan0 set type managed >/dev/null 2>&1 || true

	# Re-apply configured regulatory domain in case the 2.4 GHz AP advertised
	# a conflicting 802.11d Country IE that could block 5 GHz Channel 36.
	if [ -n "${AAWG_COUNTRY_CODE:-}" ]; then
		iw reg set "${AAWG_COUNTRY_CODE}" 2>/dev/null || true
	fi

	# Allow CYW43455 SDIO firmware state machine to settle before hostapd starts
	sleep 0.2
}

write_wpa_conf() {
	TARGET_FREQ_LIST="$1"
	(
		umask 077
		{
			printf 'ap_scan=1\n'
			[ -n "$TARGET_FREQ_LIST" ] && printf '%s\n' "$TARGET_FREQ_LIST"
			printf 'network={\n'
			printf '\tssid="%s"\n' "$ESC_SSID"
			printf '\tscan_ssid=%s\n' "$SCAN_SSID"
			if [ -n "$PASSWORD" ]; then
				printf '\tpsk="%s"\n' "$ESC_PASS"
				printf '\tkey_mgmt=WPA-PSK\n'
			else
				printf '\tkey_mgmt=NONE\n'
			fi
			[ -n "$TARGET_FREQ_LIST" ] && printf '\t%s\n' "$TARGET_FREQ_LIST"
			printf '}\n'
		} > "$WPA_CONF"
	)
}

write_udhcpc_script() {
	cat << 'EOF' > "$UDHCPC_SCRIPT"
#!/bin/sh
case "$1" in
	bound|renew)
		ifconfig "$interface" "$ip" ${subnet:+netmask "$subnet"} up
		FIRST_GW=""
		for gw in $router; do
			if [ -z "$FIRST_GW" ]; then
				FIRST_GW="$gw"
			fi
			ip route add default via "$gw" dev "$interface" 2>/dev/null && break
		done
		if [ -n "$dns" ]; then
			: > /tmp/resolv.conf
			for ns in $dns; do
				echo "nameserver $ns" >> /tmp/resolv.conf
			done
		fi
		{
			printf 'GARAGE_IP="%s"\n' "$ip"
			printf 'GARAGE_SUBNET="%s"\n' "${subnet:-255.255.255.0}"
			printf 'GARAGE_GW="%s"\n' "$FIRST_GW"
		} > /var/run/garage_dhcp.env
		;;
esac
exit 0
EOF
	chmod 700 "$UDHCPC_SCRIPT"
}

wait_for_wpa_connection() {
	MAX_TICKS="$1"
	TICK=0
	while [ "$TICK" -lt "$MAX_TICKS" ]; do
		if [ "$(cat /sys/class/net/wlan0/carrier 2>/dev/null)" = "1" ] && \
		   iw dev wlan0 link 2>/dev/null | grep -q "^Connected to " && \
		   grep -q "CTRL-EVENT-CONNECTED" "$WPA_LOG" 2>/dev/null; then
			return 0
		fi
		sleep 0.1
		TICK=$((TICK + 1))
	done
	return 1
}

load_garage_config() {
	SSID="${AAWG_GARAGE_WIFI_SSID:-}"
	PASSWORD="${AAWG_GARAGE_WIFI_PASSWORD:-}"
	HIDDEN="${AAWG_GARAGE_WIFI_HIDDEN:-1}"
	BAND="${AAWG_GARAGE_WIFI_BAND:-2.4}"
	UDP_HOST="${AAWG_GARAGE_UDP_HOST:-}"
	UDP_PORT="${AAWG_GARAGE_UDP_PORT:-9876}"
	UDP_PAYLOAD="${AAWG_GARAGE_UDP_PAYLOAD:-OPEN_GARAGE}"
	TIMEOUT_SEC="${AAWG_GARAGE_TIMEOUT_SEC:-5}"

	case "$TIMEOUT_SEC" in
		''|*[!0-9]*) TIMEOUT_SEC=5 ;;
	esac
	[ "$TIMEOUT_SEC" -lt 2 ] && TIMEOUT_SEC=2
	[ "$TIMEOUT_SEC" -gt 15 ] && TIMEOUT_SEC=15

	ESC_SSID=$(printf '%s' "$SSID" | sed 's/\\/\\\\/g; s/"/\\"/g')
	ESC_PASS=$(printf '%s' "$PASSWORD" | sed 's/\\/\\\\/g; s/"/\\"/g')
	SCAN_SSID=0
	[ "$HIDDEN" = "1" ] && SCAN_SSID=1

	FULL_FREQ_LIST=""
	if [ "$BAND" = "2.4" ]; then
		FULL_FREQ_LIST="freq_list=2412 2417 2422 2427 2432 2437 2442 2447 2452 2457 2462 2467 2472"
	fi
}

probe_garage_at_boot() {
	rm -f "$GARAGE_IN_RANGE_FLAG" "$GARAGE_OPENED_ONCE_FLAG" "$GARAGE_ENV_FILE" "$GARAGE_DHCP_ENV" "$GARAGE_HOLD_FLAG" /var/run/garage_disarmed
	rm -rf "$GARAGE_LOCK_DIR" 2>/dev/null || true

	if [ "${AAWG_ENABLE_GARAGE_OPEN:-0}" != "1" ]; then
		log_info "Disabled (AAWG_ENABLE_GARAGE_OPEN != 1), skipping boot probe."
		return 0
	fi

	if [ "${AAWG_GARAGE_HOLD_UNTIL_START:-1}" = "0" ]; then
		log_info "AAWG_GARAGE_HOLD_UNTIL_START=0; starting Android Auto AP directly without hold."
		return 0
	fi

	load_garage_config

	if [ -z "$SSID" ] || [ -z "$UDP_HOST" ] || [ -z "$UDP_PORT" ]; then
		log_info "Missing garage SSID or UDP target configuration, skipping."
		return 0
	fi

	if pidof hostapd >/dev/null 2>&1; then
		log_info "hostapd is already running on wlan0; skipping boot probe."
		return 0
	fi

	WAIT_COUNT=0
	while [ ! -d /sys/class/net/wlan0 ] && [ "$WAIT_COUNT" -lt 50 ]; do
		sleep 0.2
		WAIT_COUNT=$((WAIT_COUNT + 1))
	done

	if [ ! -d /sys/class/net/wlan0 ]; then
		log_info "wlan0 interface did not appear in time, skipping."
		return 0
	fi

	# Wait up to 5s for the shared CYW43455 Bluetooth controller (hci0) to finish
	# downloading its BCM4345C0 .hcd firmware patch over UART before wlan0 starts
	# active 2.4 GHz scanning on the shared radio/antenna.
	rfkill unblock bluetooth 2>/dev/null || true
	BT_WAIT=0
	while [ "$BT_WAIT" -lt 25 ]; do
		if [ -d /sys/class/bluetooth/hci0 ] && dmesg 2>/dev/null | grep -q "BCM4345C0.*build [1-9]"; then
			break
		fi
		sleep 0.2
		BT_WAIT=$((BT_WAIT + 1))
	done
	rfkill unblock bluetooth 2>/dev/null || true
	hciconfig hci0 up 2>/dev/null || true
	sleep 0.3

	GARAGE_TOUCHED_WLAN0=1
	trap 'trap "" EXIT INT TERM; cleanup; exit 0' EXIT INT TERM

	MAIN_PID=$$
	HARD_LIMIT=$((TIMEOUT_SEC + 5))
	(
		trap 'kill "$SPID" 2>/dev/null || true; exit 0' TERM INT
		sleep "$HARD_LIMIT" &
		SPID=$!
		if wait "$SPID" 2>/dev/null; then
			logger -p daemon.warning -t garage_opener "Boot probe hard watchdog (${HARD_LIMIT}s) reached; aborting to start Android Auto AP." 2>/dev/null || true
			kill -TERM "$MAIN_PID" 2>/dev/null || true
		fi
	) </dev/null >/dev/null 2>&1 &
	WATCHDOG_PID=$!

	rfkill unblock wifi 2>/dev/null || true
	if [ -n "${AAWG_COUNTRY_CODE:-}" ]; then
		iw reg set "${AAWG_COUNTRY_CODE}" 2>/dev/null || true
	fi
	ip link set wlan0 up 2>/dev/null || true
	iw dev wlan0 set power_save off 2>/dev/null || true

	write_wpa_conf "$FULL_FREQ_LIST"

	rm -f "$WPA_LOG"
	log_info "Probing garage Wi-Fi '${SSID}' at boot (hidden=${SCAN_SSID}, band=${BAND}, timeout=${TIMEOUT_SEC}s)..."
	if ! wpa_supplicant -D nl80211 -i wlan0 -c "$WPA_CONF" -P "$WPA_PIDFILE" -f "$WPA_LOG" -B >/dev/null 2>&1; then
		log_info "Failed to launch wpa_supplicant during boot probe."
		return 0
	fi

	if ! wait_for_wpa_connection $((TIMEOUT_SEC * 10)); then
		log_info "Garage Wi-Fi '${SSID}' not in range at boot (${TIMEOUT_SEC}s timeout); garage trigger disarmed for this drive."
		return 0
	fi

	# iw 5.19+ prints "freq: 2412.0"; strip any fractional suffix and fallback to WPA_LOG
	GARAGE_FREQ=$(iw dev wlan0 link 2>/dev/null | awk '/freq:/ {sub(/\..*/, "", $2); print $2; exit}')
	if [ -z "$GARAGE_FREQ" ] && [ -f "$WPA_LOG" ]; then
		GARAGE_FREQ=$(sed -n 's/.*freq=\([0-9][0-9]*\).*/\1/p' "$WPA_LOG" 2>/dev/null | tail -n 1)
	fi
	case "$GARAGE_FREQ" in
		''|*[!0-9]*) GARAGE_FREQ="" ;;
	esac

	write_udhcpc_script
	rm -f "$GARAGE_DHCP_ENV"
	if ! udhcpc -i wlan0 -n -q -t 2 -T 1 -A 0 -p "$UDHCPC_PIDFILE" -s "$UDHCPC_SCRIPT" >/dev/null 2>&1; then
		log_info "DHCP lease failed on '${SSID}' during boot probe; garage trigger disarmed for this drive."
		return 0
	fi

	# Pre-resolve Layer-2 ARP MAC of UDP_HOST via ICMP without sending UDP to port 9876
	ping -c 1 -W 1 "$UDP_HOST" >/dev/null 2>&1 || true
	GARAGE_TARGET_MAC=$(awk -v ip="$UDP_HOST" '$1 == ip && $3 != "0x0" && $4 != "00:00:00:00:00:00" && $6 == "wlan0" {print $4; exit}' /proc/net/arp 2>/dev/null)
	if [ -z "$GARAGE_TARGET_MAC" ]; then
		ping -c 1 -W 1 "$UDP_HOST" >/dev/null 2>&1 || true
		GARAGE_TARGET_MAC=$(awk -v ip="$UDP_HOST" '$1 == ip && $3 != "0x0" && $4 != "00:00:00:00:00:00" && $6 == "wlan0" {print $4; exit}' /proc/net/arp 2>/dev/null)
	fi

	if [ -f "$GARAGE_DHCP_ENV" ]; then
		. "$GARAGE_DHCP_ENV"
		cp "$GARAGE_DHCP_ENV" "$GARAGE_ENV_FILE"
	else
		: > "$GARAGE_ENV_FILE"
	fi

	GARAGE_GW_MAC=""
	if [ -n "${GARAGE_GW:-}" ]; then
		GARAGE_GW_MAC=$(awk -v ip="$GARAGE_GW" '$1 == ip && $3 != "0x0" && $4 != "00:00:00:00:00:00" && $6 == "wlan0" {print $4; exit}' /proc/net/arp 2>/dev/null)
	fi

	{
		printf 'GARAGE_FREQ="%s"\n' "$GARAGE_FREQ"
		printf 'GARAGE_TARGET_IP="%s"\n' "$UDP_HOST"
		printf 'GARAGE_TARGET_MAC="%s"\n' "$GARAGE_TARGET_MAC"
		printf 'GARAGE_GW_MAC="%s"\n' "$GARAGE_GW_MAC"
	} >> "$GARAGE_ENV_FILE"

	touch "$GARAGE_IN_RANGE_FLAG"
	touch "$GARAGE_HOLD_FLAG"
	log_info "Garage Wi-Fi '${SSID}' detected at boot (freq=${GARAGE_FREQ:-auto} MHz, ip=${GARAGE_IP:-dhcp}); holding Android Auto radios until Car START."
	return 0
}

release_hold() {
	if ! mkdir "$GARAGE_LOCK_DIR" 2>/dev/null; then
		log_info "Garage fire already in progress; skipping release."
		return 0
	fi
	touch /var/run/garage_disarmed
	rm -f "$GARAGE_IN_RANGE_FLAG"
	if [ -f "$GARAGE_HOLD_FLAG" ]; then
		GARAGE_TOUCHED_WLAN0=1
		cleanup
		rm -f "$GARAGE_HOLD_FLAG"
		log_info "Garage hold released without opening; garage trigger disarmed for this drive."
	fi
}

fire_garage_at_runtime() {
	if [ -f "$GARAGE_OPENED_ONCE_FLAG" ] || [ -f "/var/run/garage_disarmed" ] || ! mkdir "$GARAGE_LOCK_DIR" 2>/dev/null; then
		log_info "Garage opener already fired, disarmed, or locked; skipping."
		return 0
	fi
	touch "$GARAGE_OPENED_ONCE_FLAG"
	rm -f "$GARAGE_IN_RANGE_FLAG"

	if [ ! -f "$GARAGE_HOLD_FLAG" ]; then
		log_info "Garage hold is not active; skipping door trigger (hold expired or not in garage)."
		return 0
	fi

	if [ "${AAWG_ENABLE_GARAGE_OPEN:-0}" != "1" ]; then
		log_info "Disabled (AAWG_ENABLE_GARAGE_OPEN != 1), skipping fire."
		return 0
	fi

	load_garage_config

	if [ -z "$SSID" ] || [ -z "$UDP_HOST" ] || [ -z "$UDP_PORT" ]; then
		log_info "Missing garage SSID or UDP target configuration, skipping."
		return 0
	fi

	GARAGE_TOUCHED_WLAN0=1
	touch /var/run/garage_firing 2>/dev/null || true
	trap 'trap "" EXIT INT TERM; cleanup; rm -f "$GARAGE_HOLD_FLAG" /var/run/garage_firing 2>/dev/null || true; exit 0' EXIT INT TERM

	if [ -f "$GARAGE_ENV_FILE" ]; then
		. "$GARAGE_ENV_FILE"
	fi

	# Fast path: the boot probe left wlan0 associated with the garage AP
	if ! wait_for_wpa_connection 20; then
		log_info "Held garage link dropped; re-associating with '${SSID}'..."
		kill_wpa_and_wait
		rm -f "$WPA_LOG"
		write_wpa_conf "${GARAGE_FREQ:+freq_list=${GARAGE_FREQ}}"
		if ! wpa_supplicant -D nl80211 -i wlan0 -c "$WPA_CONF" -P "$WPA_PIDFILE" -f "$WPA_LOG" -B >/dev/null 2>&1 || \
		   ! wait_for_wpa_connection $((TIMEOUT_SEC * 10)); then
			log_info "Failed to re-associate with '${SSID}'; releasing Android Auto radios without opening."
			return 0
		fi
	fi

	if ! ip -4 addr show dev wlan0 2>/dev/null | grep -q "inet "; then
		write_udhcpc_script
		if ! udhcpc -i wlan0 -n -q -t 2 -T 1 -A 0 -p "$UDHCPC_PIDFILE" -s "$UDHCPC_SCRIPT" >/dev/null 2>&1; then
			log_info "Failed to configure IP on '${SSID}'; releasing Android Auto radios without opening."
			return 0
		fi
	fi
	if [ -n "${GARAGE_TARGET_IP:-}" ] && [ -n "${GARAGE_TARGET_MAC:-}" ]; then
		ip neigh replace "$GARAGE_TARGET_IP" lladdr "$GARAGE_TARGET_MAC" nud reachable dev wlan0 2>/dev/null || true
	fi

	if /usr/bin/garage_udp_send "$UDP_HOST" "$UDP_PORT" "$UDP_PAYLOAD"; then
		log_info "Garage UDP trigger sent to ${UDP_HOST}:${UDP_PORT} over held link; releasing Android Auto radios."
	else
		log_info "Garage UDP send failed to ${UDP_HOST}:${UDP_PORT}; releasing Android Auto radios."
	fi
	return 0
}

case "$1" in
	start)
		probe_garage_at_boot
		stop_watchdog
		trap '' EXIT INT TERM
		if [ -f "$GARAGE_HOLD_FLAG" ]; then
			# Keep wpa_supplicant + lease alive; S43garage_gate owns the hold
			GARAGE_TOUCHED_WLAN0=0
		else
			cleanup
		fi
		;;
	fire)
		fire_garage_at_runtime
		stop_watchdog
		trap '' EXIT INT TERM
		cleanup
		rm -f "$GARAGE_HOLD_FLAG" /var/run/garage_firing 2>/dev/null || true
		;;
	release)
		release_hold
		;;
	stop)
		if [ -f "$WPA_PIDFILE" ]; then
			GARAGE_TOUCHED_WLAN0=1
			trap '' EXIT INT TERM
			cleanup
		fi
		;;
	*)
		echo "Usage: $0 {start|fire|release|stop}"
		exit 1
		;;
esac

exit 0
