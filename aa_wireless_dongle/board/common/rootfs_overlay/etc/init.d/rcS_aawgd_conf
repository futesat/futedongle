#!/bin/sh
#
# Setup AAWG configuration
#
set -o allexport

if [ -z "$AAWG_CONF_SOURCED" ]; then
	if [ -r /etc/aawgd.conf ]; then
		echo "Source /etc/aawgd.conf"
		. /etc/aawgd.conf
		export AAWG_CONF_SOURCED=1
	fi
fi


## Setup Wifi password
if [ -z "${AAWG_WIFI_PASSWORD}" ]; then
	if [ -f /var/run/aawgd_wifi_password ]; then
		export AAWG_WIFI_PASSWORD="$(cat /var/run/aawgd_wifi_password)"
	else
		export AAWG_WIFI_PASSWORD="$(cat /dev/urandom | tr -dc 'A-Za-z0-9@#' | head -c 16)"
		echo -n "${AAWG_WIFI_PASSWORD}" > /var/run/aawgd_wifi_password
	fi
fi

set +o allexport