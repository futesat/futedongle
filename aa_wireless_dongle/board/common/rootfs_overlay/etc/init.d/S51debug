#!/bin/sh
#
# Optional diagnostic network (AAWG_ENABLE_SSH=1) and SD boot telemetry (AAWG_ENABLE_DEBUG_LOG=1)
#

if [ -z "$AAWG_CONF_SOURCED" ] && [ -r /etc/aawgd.conf ]; then
	. /etc/aawgd.conf
fi

case "$1" in
	start)
		# Bring up eth0 with non-blocking background DHCP only when SSH is enabled; otherwise power it down
		if [ "$AAWG_ENABLE_SSH" = "1" ]; then
			if [ -d /sys/class/net/eth0 ]; then
				/sbin/ifconfig eth0 up 2>/dev/null || true
				/sbin/udhcpc -b -S -p /var/run/udhcpc.eth0.pid -i eth0 >/dev/null 2>&1 &
			fi
		else
			if [ -d /sys/class/net/eth0 ]; then
				/sbin/ifconfig eth0 down 2>/dev/null || true
			fi
		fi

		# Launch bounded boot/handshake telemetry (6 snapshots x 15s = 90s) only when AAWG_ENABLE_DEBUG_LOG=1
		if [ "$AAWG_ENABLE_DEBUG_LOG" = "1" ]; then
			(
				SNAPSHOT=0
				while [ "$SNAPSHOT" -lt 6 ]; do
					sleep 15
					SNAPSHOT=$((SNAPSHOT + 1))
					if /bin/mount -o remount,rw /boot 2>/dev/null; then
						{
							echo "=== CAR TELEMETRY ($SNAPSHOT/6) $(date) ==="
							uptime
							echo "--- USB UDC & GADGET STATE ---"
							for f in /sys/class/udc/*/state /sys/class/udc/*/current_speed /sys/class/udc/*/function /sys/kernel/config/usb_gadget/*/UDC; do
								[ -e "$f" ] && echo "$f: $(cat "$f" 2>/dev/null)"
							done
							echo "--- BLUETOOTH & RFKILL ---"
							/usr/sbin/rfkill list 2>/dev/null || true
							/usr/bin/bluetoothctl show 2>/dev/null || true
							echo "--- NETWORK & DHCP LEASES ---"
							/sbin/ip addr 2>/dev/null || true
							cat /var/lib/misc/dnsmasq.leases 2>/dev/null || true
							echo "--- PROCESSES ---"
							/bin/ps
							echo "--- HOSTAPD CONF ---"
							grep -v "^wpa_passphrase=" /var/run/hostapd.conf 2>/dev/null || true
							echo "--- HOSTAPD LOG ---"
							cat /var/log/hostapd 2>/dev/null || true
							echo "--- FULL SYSLOG (/var/log/messages) ---"
							cat /var/log/messages 2>/dev/null || true
							echo "--- DMESG ---"
							/bin/dmesg 2>/dev/null || true
						} > /boot/car_debug.log 2>&1
						sync
						/bin/mount -o remount,ro /boot 2>/dev/null || true
					fi
				done
				rm -f /var/run/car_logger.pid
			) </dev/null >/dev/null 2>&1 &
			echo $! > /var/run/car_logger.pid
		fi
		;;
	stop)
		if [ -f /var/run/car_logger.pid ]; then
			kill "$(cat /var/run/car_logger.pid)" 2>/dev/null || true
			rm -f /var/run/car_logger.pid
		fi
		if [ -f /var/run/udhcpc.eth0.pid ]; then
			kill "$(cat /var/run/udhcpc.eth0.pid)" 2>/dev/null || true
			rm -f /var/run/udhcpc.eth0.pid
		fi
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac

exit 0

