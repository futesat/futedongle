#!/bin/sh
#
# Setup hostapd configuration
#

case "$1" in
	start)
		if [ -z "$AAWG_CONF_SOURCED" ] && [ -r /etc/aawgd.conf ]; then
			echo "Source /etc/aawgd.conf"
			set -a
			. /etc/aawgd.conf
			set +a
		fi
		if [ -z "${AAWG_WIFI_PASSWORD}" ] && [ -f /var/run/aawgd_wifi_password ]; then
			AAWG_WIFI_PASSWORD="$(cat /var/run/aawgd_wifi_password)"
		fi

		# Wait up to 10s for async brcmfmac SDIO firmware load to create wlan0
		WAIT_COUNT=0
		while [ ! -d /sys/class/net/wlan0 ] && [ "$WAIT_COUNT" -lt 50 ]; do
			sleep 0.2
			WAIT_COUNT=$((WAIT_COUNT + 1))
		done

		# Ensure Wi-Fi and Bluetooth radios are not soft-blocked by rfkill before S40.
		# Bring hci0 UP before S40bluetooth starts bluetoothd: in Linux 6.6.28,
		# hci_power_on_sync() closes hci0 after HCI_AUTO_OFF_TIMEOUT (2s), and
		# MGMT_OP_REMOVE_ADV_MONITOR / REMOVE_UUID / ADD_UUID use hci_cmd_sync_queue()
		# which fails with -ENETDOWN (0x03) unless HCI_RUNNING is set.
		rfkill unblock wifi 2>/dev/null || true
		rfkill unblock bluetooth 2>/dev/null || true
		hciconfig hci0 up 2>/dev/null || true

		# Normalize CTKD-generated LE AddressType in /var/lib/bluetooth/*/*/info so
		# BlueZ 5.79 load_ltks()/load_irks() pass BDADDR_LE_PUBLIC instead of
		# BDADDR_BREDR (0) or BDADDR_LE_RANDOM on IEEE public MACs (preventing 0x0d).
		for info_file in /var/lib/bluetooth/*/*/info; do
			[ -f "$info_file" ] || continue
			if grep -qE '^\[(LongTermKey|SlaveLongTermKey|PeripheralLongTermKey|IdentityResolvingKey)\]' "$info_file" 2>/dev/null; then
				if grep -q '^AddressType=static' "$info_file" 2>/dev/null; then
					sed -i 's/^AddressType=static/AddressType=public/' "$info_file" 2>/dev/null || true
				elif ! grep -q '^AddressType=' "$info_file" 2>/dev/null; then
					sed -i '/^\[General\]/a AddressType=public' "$info_file" 2>/dev/null || true
				fi
			fi
		done

		if [ -n "${AAWG_COUNTRY_CODE}" ]; then
			/usr/sbin/iw reg set "${AAWG_COUNTRY_CODE}" 2>/dev/null || true
		fi

		echo "Generate hostapd configuration at /var/run/hostapd.conf"

		cp /etc/hostapd.conf.in /var/run/hostapd.conf

		echo >> /var/run/hostapd.conf

		# Override Wifi SSID if set
		if [ -n "${AAWG_WIFI_SSID}" ]; then
			sed -i "s/^ssid=.*/ssid=${AAWG_WIFI_SSID}/" /var/run/hostapd.conf
		fi

		# Add Wifi password
		if [ -n "${AAWG_WIFI_PASSWORD}" ]; then
			echo "wpa_passphrase=${AAWG_WIFI_PASSWORD}" >> /var/run/hostapd.conf
		fi

		# Add or update Wifi country code if set
		if [ -n "${AAWG_COUNTRY_CODE}" ]; then
			if grep -q "^country_code=" /var/run/hostapd.conf; then
				sed -i "s/^country_code=.*/country_code=${AAWG_COUNTRY_CODE}/" /var/run/hostapd.conf
			else
				echo "country_code=${AAWG_COUNTRY_CODE}" >> /var/run/hostapd.conf
			fi
		fi
		;;
	*)
		echo "Usage: $0 {start}"
		exit 1
esac

exit $?
