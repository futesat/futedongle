#!/bin/sh
#
# Setup hostapd configuration
#

case "$1" in
	start)
		if [ -z "$AAWG_CONF_SOURCED" ] && [ -r /etc/aawgd.conf ]; then
			echo "Source /etc/aawgd.conf"
			. /etc/aawgd.conf
		fi

		# Wait up to 10s for async brcmfmac SDIO firmware load to create wlan0
		WAIT_COUNT=0
		while [ ! -d /sys/class/net/wlan0 ] && [ "$WAIT_COUNT" -lt 50 ]; do
			sleep 0.2
			WAIT_COUNT=$((WAIT_COUNT + 1))
		done

		# Ensure Wi-Fi radio is not soft-blocked by rfkill and set regulatory domain
		rfkill unblock wifi 2>/dev/null || true
		if [ -n "${AAWG_COUNTRY_CODE}" ]; then
			/usr/sbin/iw reg set "${AAWG_COUNTRY_CODE}" 2>/dev/null || true
		fi

		echo "Generate hostapd configuration at /var/run/hostapd.conf"

		cp /etc/hostapd.conf.in /var/run/hostapd.conf

		echo >> /var/run/hostapd.conf

		# Override Wifi SSID if set
		if [ -n "${AAWG_WIFI_SSID}" ]; then
			sed -i "s/^ssid=.*/ssid=${AAWG_WIFI_SSID}/" /var/run/hostapd.conf
		fi

		# Add Wifi password
		if [ -n "${AAWG_WIFI_PASSWORD}" ]; then
			echo "wpa_passphrase=${AAWG_WIFI_PASSWORD}" >> /var/run/hostapd.conf
		fi

		# Add or update Wifi country code if set
		if [ -n "${AAWG_COUNTRY_CODE}" ]; then
			if grep -q "^country_code=" /var/run/hostapd.conf; then
				sed -i "s/^country_code=.*/country_code=${AAWG_COUNTRY_CODE}/" /var/run/hostapd.conf
			else
				echo "country_code=${AAWG_COUNTRY_CODE}" >> /var/run/hostapd.conf
			fi
		fi
		;;
	*)
		echo "Usage: $0 {start}"
		exit 1
esac

exit $?
