#!/bin/sh
#
# aawgd_supervisor - Process supervisor to ensure aawgd auto-respawns
#

trap 'kill -TERM $PID 2>/dev/null; exit 0' TERM INT

# Wait up to 10s for Bluetooth HCI adapter before initial start
WAIT_COUNT=0
while [ ! -d /sys/class/bluetooth/hci0 ] && [ "$WAIT_COUNT" -lt 50 ]; do
	sleep 0.2
	WAIT_COUNT=$((WAIT_COUNT + 1))
done
rfkill unblock bluetooth 2>/dev/null || true

while true; do
	if [ -r /etc/aawgd.conf ]; then
		set -a
		. /etc/aawgd.conf
		set +a
	fi

	if [ -z "$AAWG_WIFI_PASSWORD" ] && [ -f /var/run/aawgd_wifi_password ]; then
		export AAWG_WIFI_PASSWORD="$(cat /var/run/aawgd_wifi_password)"
	fi

	/usr/bin/aawgd &
	PID=$!
	wait $PID
	STATUS=$?

	logger -t aawgd-supervisor "aawgd exited with status $STATUS. Respawning in 2 seconds..."
	sleep 2
done

